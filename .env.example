# DATABASE_URL: PostgreSQL connection string for catalog families, variants, categories, and inquiries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# GEMINI_API_KEY: Required for Gemini Vision & AI API calls (e.g. gemini-2.5-flash).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SERPER_API_KEY: Required for Google Image search via https://google.serper.dev/images in scripts/real-belt-image-pipeline.ts.
SERPER_API_KEY="MY_SERPER_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
